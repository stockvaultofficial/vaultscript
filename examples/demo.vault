// StockVault VaultScript example

let shares = 10

asset AAPL {
    name: "Apple Inc."
    type: "equity"
    ticker: "AAPL"
    price: 255
    supply: 1000000
    tokenized: true
}

asset TSLA {
    name: "Tesla Inc."
    type: "equity"
    ticker: "TSLA"
    price: 450
    supply: 500000
    tokenized: true
}

print "StockVault Asset Registry"

print AAPL.name
print AAPL.price

print TSLA.name
print TSLA.price

print shares * AAPL.price