{
  "name": "@stockvault/vaultscript",
  "version": "0.4.0",
  "description": "VaultScript — the language for defining, validating and compiling tokenized real-world assets on StockVault.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "vault": "dist/index.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('dist-tests',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && node dist-tests/tests/vaultscript.test.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "stockvault",
    "vaultscript",
    "rwa",
    "real-world-assets",
    "tokenization",
    "blockchain",
    "dsl"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
